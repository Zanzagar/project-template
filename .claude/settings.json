{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh session-init $CLAUDE_PROJECT_DIR/.claude/hooks/session-init.sh minimal,standard,strict"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh project-index $CLAUDE_PROJECT_DIR/.claude/hooks/project-index.sh minimal,standard,strict"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh observe $CLAUDE_PROJECT_DIR/.claude/hooks/observe.sh standard,strict pre"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh pre-commit-check $CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-check.sh minimal,standard,strict",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js auto-tmux-dev $CLAUDE_PROJECT_DIR/.claude/hooks/auto-tmux-dev.js standard,strict"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js dev-server-blocker $CLAUDE_PROJECT_DIR/.claude/hooks/dev-server-blocker.js strict"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh long-running-tmux-hint $CLAUDE_PROJECT_DIR/.claude/hooks/long-running-tmux-hint.sh strict"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js file-size-guard $CLAUDE_PROJECT_DIR/.claude/hooks/file-size-guard.js standard,strict"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh protect-sensitive-files $CLAUDE_PROJECT_DIR/.claude/hooks/protect-sensitive-files.sh minimal,standard,strict"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh doc-file-blocker $CLAUDE_PROJECT_DIR/.claude/hooks/doc-file-blocker.sh strict"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh protect-sensitive-files $CLAUDE_PROJECT_DIR/.claude/hooks/protect-sensitive-files.sh minimal,standard,strict"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh observe $CLAUDE_PROJECT_DIR/.claude/hooks/observe.sh standard,strict post"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js post-edit-format $CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-format.js standard,strict"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js console-log-audit $CLAUDE_PROJECT_DIR/.claude/hooks/console-log-audit.js standard,strict"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js typescript-check $CLAUDE_PROJECT_DIR/.claude/hooks/typescript-check.js strict"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js quality-gate $CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.js standard,strict"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js post-edit-format $CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-format.js standard,strict"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js quality-gate $CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.js standard,strict"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh build-analysis $CLAUDE_PROJECT_DIR/.claude/hooks/build-analysis.sh standard,strict"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh pr-url-extract $CLAUDE_PROJECT_DIR/.claude/hooks/pr-url-extract.sh standard,strict"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh pre-compact $CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.sh minimal,standard,strict"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js suggest-compact $CLAUDE_PROJECT_DIR/.claude/hooks/suggest-compact.js standard,strict"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js session-end $CLAUDE_PROJECT_DIR/.claude/hooks/session-end.js minimal,standard,strict"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js cost-tracker $CLAUDE_PROJECT_DIR/.claude/hooks/cost-tracker.js standard,strict",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags.js check-console-log $CLAUDE_PROJECT_DIR/.claude/hooks/check-console-log.js standard,strict"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lib/run-with-flags-shell.sh pattern-extraction $CLAUDE_PROJECT_DIR/.claude/hooks/pattern-extraction.sh minimal,standard,strict"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.env)",
      "Read(**/credentials*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(~/.ssh/*)",
      "Write(~/.aws/*)",
      "Write(**/.env*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/credentials*)",
      "Bash(git * push --force *)",
      "Bash(git * push -f *)",
      "Bash(git * push --force-with-lease *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git * commit --no-verify *)",
      "Bash(git * commit * --no-verify)",
      "Bash(git * commit * --no-verify *)",
      "Bash(git * commit -n *)",
      "Bash(git * commit * -n)",
      "Bash(git * commit * -n *)"
    ],
    "ask": [
      "Workflow",
      "Bash(git reset --hard *)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Bash(gh repo delete *)"
    ]
  },
  "_harness": "claude-harness settings/permissions-deny.snippet.json + settings/git-hygiene.snippet.json (floor as amended 2026-09-24) merged 2026-09-28 with the grilling gate adopted (.githooks + .github/workflows/grill-gate.yml, core.hooksPath=.githooks per clone), on the owner's decision of 2026-09-28: every project gets the rules and the commit gate. Deny = credential guards, force-push in any spelling, deleting main/master, --no-verify/-n; ask = Workflow, reset --hard, remote-branch deletion, repository deletion."
}
